# Stripe Keys — get these from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# Email delivery (Resend) — REQUIRED for appointment requests and the contact
# form to actually reach you. Without it, submissions are only written to the
# server log and you will never see them. https://resend.com/api-keys
RESEND_API_KEY=re_...

# Where appointment requests and contact form submissions are sent.
CONTACT_EMAIL=lilliechris06@gmail.com

# Google Calendar availability — see SETUP.md for setup steps
GOOGLE_CALENDAR_ID=your-email@gmail.com
GOOGLE_CALENDAR_API_KEY=AIza...

# Google Calendar event creation for bookings — see SETUP.md step 6
GOOGLE_SERVICE_ACCOUNT_EMAIL=website-bookings@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Live Google reviews on the homepage — see SETUP.md section 6.
# Server-side only. Never prefix these with NEXT_PUBLIC_ (that would expose
# them in the browser). Run `node scripts/gbp-setup.mjs` to get the GBP_ ones.
# With none set, the section shows only a link to the reviews on Google.
GBP_CLIENT_ID=...apps.googleusercontent.com
GBP_CLIENT_SECRET=GOCSPX-...
GBP_REFRESH_TOKEN=1//...
GBP_ACCOUNT_ID=1234567890
GBP_LOCATION_ID=1234567890
GOOGLE_PLACE_ID=ChIJ...

# Optional stop-gap until Business Profile API access is approved
# (Google picks which 5 reviews; not necessarily the newest).
GOOGLE_PLACES_API_KEY=AIza...
